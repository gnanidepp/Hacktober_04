# Copy to .env. Real inference is the default; mock is always an explicit choice.
AGENTGUARD_PROVIDER=google_ai_studio
AGENTGUARD_MODEL=gemma-4-26b-a4b-it
AGENTGUARD_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
AGENTGUARD_API_KEY=
# json_schema | json_object | prompt. Use prompt for endpoints without structured output.
AGENTGUARD_RESPONSE_FORMAT=prompt
AGENTGUARD_TIMEOUT=60
AGENTGUARD_APPROVAL_TTL=300
AGENTGUARD_MAX_FILE_BYTES=65536
AGENTGUARD_DENIED_TOOLS=
AGENTGUARD_PROTECTED_PATHS=protected
# Optional: otherwise independent admin/agent tokens are generated under data/.
AGENTGUARD_ADMIN_TOKEN=
AGENTGUARD_AGENT_TOKEN=
# Hosted endpoint example (base URL including /v1, exact model from its /models):
# AGENTGUARD_PROVIDER=openai_compatible
# AGENTGUARD_ENDPOINT=https://YOUR-PROVIDER.example/v1
# AGENTGUARD_MODEL=EXACT-GEMMA-4-MODEL-ID
# AGENTGUARD_API_KEY=ADD-YOUR-KEY-LOCALLY
# Test demonstration only: AGENTGUARD_PROVIDER=mock
# Local alternative: provider=ollama, model=gemma4:e2b,
# endpoint=http://127.0.0.1:11434, response_format=json_schema, api_key empty.
